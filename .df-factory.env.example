# Dark Factory local launcher defaults for FlexCMS.
# Copy to `.df-factory.env` or edit that file directly.

# Role-session adapter. This wrapper calls GitHub Models through `gh models run`
# and applies model-returned FILE blocks.
DF_AGENT_CMD='python3 agents/df-gh-agent.py'

# Optional: delegate role-session coding work to GitHub Copilot Cloud Agent tasks
# through the GitHub REST API instead of local Copilot/GitHub Models execution.
# The API is public preview: verify the current official endpoint, preview
# headers, token permissions, and request/response schema before live use.
#
# Direct cloud runner:
# DF_AGENT_CMD='./df/agent-router/copilot-cloud-agent.py'
#
# Or via the generic local runner wrapper:
# DF_AGENT_CMD='./df/agent-router/run-role-session.bash'
# DF_AGENT_RUNNER='copilot-cloud'
#
# Safe no-network validation mode:
# DF_COPILOT_CLOUD_DRY_RUN='true'
# DF_COPILOT_CLOUD_DRY_RUN_ADVANCE='false'
#
# Live REST configuration:
# DF_GITHUB_TOKEN=''
# If DF_GITHUB_TOKEN/GITHUB_TOKEN/GH_TOKEN are unset, the runner defaults to
# `gh auth token` without printing the token. Override or disable with:
# DF_GITHUB_TOKEN_COMMAND='gh auth token'
# DF_GITHUB_OWNER=''
# DF_GITHUB_REPO=''
# DF_COPILOT_AGENT_CREATE_ENDPOINT='/agents/repos/{owner}/{repo}/tasks'
# DF_COPILOT_AGENT_API_BASE='https://api.github.com'
# DF_COPILOT_AGENT_API_VERSION='2022-11-28'
# DF_COPILOT_AGENT_ACCEPT='application/vnd.github+json'
# DF_COPILOT_AGENT_EXTRA_HEADERS='{}'
# DF_COPILOT_AGENT_MODEL='gpt-5'
# DF_COPILOT_AGENT_MODEL_BACKEND_DEV='gpt-5'
# DF_COPILOT_AGENT_MODEL_FRONTEND_DEV='gpt-5'
# DF_COPILOT_AGENT_MODEL_DEVOPS='gpt-5'
# DF_COPILOT_AGENT_MODEL_DATA_ENGINEER='gpt-5'
# DF_COPILOT_AGENT_BASE_BRANCH='main'
# DF_COPILOT_AGENT_CREATE_PR='true'
# DF_COPILOT_AGENT_POLL_SECONDS='15'
# DF_COPILOT_AGENT_TIMEOUT_SECONDS='3600'
# DF_COPILOT_AGENT_REQUIRE_CI='false'

# Factory-wide default model (used for every role unless overridden below).
# Accepts a friendly alias from MODEL_ALIASES in agents/df-gh-agent.py or a raw
# `gh models` provider id (e.g. openai/gpt-5, openai/gpt-5-mini).
DF_MODEL='Claude Sonnet 5'

# Per-role model override. Variable name is DF_MODEL_<ROLE> where <ROLE> is the
# role short-name upper-cased with '-' replaced by '_'. Examples:
#   DF_MODEL_SA, DF_MODEL_QA, DF_MODEL_PO, DF_MODEL_BACKEND_DEV,
#   DF_MODEL_FRONTEND_DEV, DF_MODEL_DEVOPS, DF_MODEL_DATA_ENGINEER, DF_MODEL_DESIGNER
# Precedence: DF_MODEL_<ROLE> > DF_MODEL > built-in default.
DF_MODEL_SA='GPT-5.5'

# Deterministic router gate. The router runs this when a delivery lane claims
# READY_FOR_QA, before the QA role can accept the task.
DF_GATE_CMD='python3 agents/factory.py validate'

# Safe defaults for local autonomous operation.
DF_FACTORY_ADAPTER='auto'
DF_FACTORY_MAX_ITERATIONS='50'
DF_FACTORY_MAX_PARALLEL='1'
DF_MAX_REWORK='3'
# Keep local runs in the current tree by default. Enable only after the Dark
# Factory control-plane files are committed and your agent command exists in HEAD.
DF_WORKTREES='0'

# Prompt budgets for GitHub Models requests. Raised so agents actually see the
# task, handoff, role checklist AND the source files listed in the task's
# "## Read first" section — without those, code lanes rewrite files blind.
# If a request 413s (tokens_limit_reached) the adapter auto-retries with the
# smaller emergency budget, so these can be generous.
DF_MODEL_MAX_PROMPT_BYTES='16000'
DF_MODEL_MAX_CONTEXT_FILE_BYTES='3000'
DF_MODEL_EMERGENCY_PROMPT_BYTES='4500'
DF_MODEL_MAX_READ_FIRST_BYTES='3500'
DF_MODEL_MAX_READ_FIRST_FILES='4'

# GitHub Models (free tier) 429 rate-limit backoff. The adapter honors the
# provider's "retry after Ns" hint, capped at RETRY_CAP_SECONDS, up to MAX_RETRIES.
DF_MODEL_MAX_RETRIES='5'
DF_MODEL_RETRY_CAP_SECONDS='180'

