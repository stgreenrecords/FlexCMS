{
  "name": "flexcms-frontend",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test --filter=!@flexcms/e2e --filter=!@flexcms/selenium-e2e",
    "test:e2e": "pnpm --filter @flexcms/e2e test",
    "test:e2e:live": "pnpm --filter @flexcms/e2e test:live",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.4.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.4.5",
      "esbuild": "0.27.4"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
