{
  "name": "flexcms-frontend",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:e2e:selenium:smoke": "pnpm --filter @flexcms/selenium-e2e ci:gate:smoke",
    "test:e2e:selenium:full": "pnpm --filter @flexcms/selenium-e2e ci:gate:full",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.4.5"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.4.5",
      "esbuild": "0.27.4"
    }
  },
  "packageManager": "pnpm@9.0.0"
}

